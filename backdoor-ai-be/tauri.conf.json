{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BackDoor AI",
  "version": "0.1.0",
  "identifier": "com.backdoor.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../backdoor-ai-ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../backdoor-ai-ui run build",
    "frontendDist": "../backdoor-ai-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BackDoor AI Assistant",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": true
      },
      {
        "label": "overlay",
        "title": "BackDoor AI HUD Overlay",
        "url": "index.html#/overlay",
        "width": 520,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: asset: https:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../tools/qdrant-x86_64-pc-windows-msvc.zip"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/StoreLogo.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/icon.png",
        "sidebarImage": "icons/icon.png"
      }
    }
  }
}
